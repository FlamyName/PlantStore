@page
@model IndexModel
@{
    ViewData["Title"] = "Новости";

    var newsError = new PlantStore.Pages.Infrastructure.ViewModels.ContentErrorViewModel
    {
        Message = "Не удалось загрузить новости",
        Region = "news"
    };
}

@if (Model.LoadFailed)
{
    <partial name="_ContentError" model="newsError" />
}
else if (Model.Items == null || !Model.Items.Any())
{
    <p class="empty-state">Новостей пока нет.</p>
}
else
{
    <div class="news-grid" id="newsGrid">
        @await Html.PartialAsync("_NewsItem", Model.Items)
    </div>
    @if (Model.HasMorePage)
    {
        <div class="load-more-container" id="loadMoreContainer">
            <button class="load-more-button"
                    id="loadMoreBtn"
                    data-page="2">
                Загрузить ещё
            </button>
            <div class="loading-spinner" id="loadingSpinner" style="display: none;">
                <div class="spinner"></div>
                <span>Загрузка...</span>
            </div>
        </div>
    }
}


<input type="hidden" id="totalItems" value="@Model.TotalItems" />
<input type="hidden" id="pageSize" value="12" />

@section Scripts {
    <script src="~/js/PageScript.js?v=@DateTime.Now.Ticks"></script>
}