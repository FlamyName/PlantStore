@model IEnumerable<PlantStore.ViewModels.ProductsViewModels>
@{

}

@foreach (var products in Model)
{

    <div class="product-card-link product-card">
            <div class="product-image">
                <img src="@products.Url"
                     loading="lazy"
                     onerror="this.src='/images/placeholder.jpg'">
            </div>
            <div class="product-info">
                <h3 class="product-title">@products.ProductName</h3>
            </div>
            <div class="product-edit">
                <button class="btn-editing" data-id="@products.Id">Редактировать</button>
                <button class="btn-delete">Удалить</button>
            </div>
        </div>
}

