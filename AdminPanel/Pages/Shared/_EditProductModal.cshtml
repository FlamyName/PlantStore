@using BusinessLogic.ViewModels
@using AdminPanel.ViewModels
@model EditProductViewModel

<div id="editProductModal" class="modal" style="display: none;">
    <div class="modal-content">
        <div class="modal-header">
            <h3>Редактировать товар</h3>
            <span class="close-btn">&times;</span>
        </div>

        <form id="editProductForm" method="post" enctype="multipart/form-data">
            <input type="hidden" id="productId" name="Id" value="@Model?.Id" />

            <div class="form-group">
                <label for="productName">Название товара:</label>
                <input type="text" id="productName" name="Name" value="@Model?.ProductName" class="form-control" required />
            </div>

            <!-- Количество / Категория / Единица в одну строку -->
            <div class="form-row">
                <div class="form-group">
                    <label for="count">Количество</label>
                    <input type="text" id="count" name="Count" value="@Model?.Count" class="form-control" required />
                </div>

                <div class="form-group">
                    <label for="categorySelect">Категория:</label>
                    <select id="categorySelect" name="CategoryId" class="form-control">
                        <option value="">Выберите категорию</option>
                        @foreach (var cat in Model.Category)
                        {
                            <option value="@cat.Id" selected="@(cat.Id == Model.CategoryId)">@cat.NameCategory</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label for="unitSelect">Единица измерения:</label>
                    <select id="unitSelect" name="UnitId" class="form-control">
                        <option value="">Выберите единицу</option>
                        @foreach (var unit in Model.Units)
                        {
                             <option value="@unit.Id" selected="@(unit.Id == Model?.UnitId)">
                                  @unit.NameUnit
                             </option>
                        }
                    </select>
                </div>
            </div>

            <div class="form-group">
                <label for="productImage">Картинки</label>
                <div class="image-slots-grid">
                    @for(int i = 0; i < 5; i++)
                    {
                        var img = Model.Images.ElementAtOrDefault(i);
                        var url = img?.Url ?? "";
                        var index = i + 1;

                        // ✅ Используем Partial View для слота
                        @await Html.PartialAsync("_ImageSlot", new ImageSlotViewModel
                        {
                            Index = index,
                            Url = url,
                            IsMain = index == 1
                        })
                    }
                </div>
            </div>

            <div class="form-group form-group--grow">
                <label for="productDescription">Описание:</label>
                <textarea id="productDescription" name="Description" class="form-control" rows="3">@Model?.Description</textarea>
            </div>

            <div class="modal-buttons">
                <button type="button" class="btn-cancel">Отмена</button>
                <button type="submit" class="btn-save">Сохранить</button>
            </div>
        </form>
    </div>
</div>